generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LoanStatus {
  ON_TIME
  RETURNED
  OVERDUE
}


model User {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  email    String  @unique
  phone    String
  loans    Loan[]
}

model Librarian {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  email    String  @unique
  password String
  loans    Loan[]
}

model Book {
  id       String  @id @default(uuid()) @db.Uuid
  title    String
  author   String
  genre    String  @default("Outro")
  isbn     String? @unique
  quantity Int     @default(1)
  loans    Loan[]
}

model Loan {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String  @db.Uuid     
  bookId      String  @db.Uuid
  librarianId String  @db.Uuid
  loanDate    DateTime    @default(now())
  dueDate     DateTime
  returnDate  DateTime?
  status      LoanStatus  @default(ON_TIME)

  user        User      @relation(fields: [userId], references: [id])
  book        Book      @relation(fields: [bookId], references: [id])
  librarian   Librarian @relation(fields: [librarianId], references: [id])
}